.desktop-shell {
  min-height: 100vh;
  display: flex;
  justify-content: center;
}

.screen {
  position: relative;
  width: 100%;
  max-width: 400px;
  min-height: 100vh;
  background: #eef5f0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: 12rpx;
  color: #1b3827;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.status-time {
  line-height: 1;
}

.status-icons {
  display: flex;
  align-items: center;
  column-gap: 12rpx;
  opacity: 0.8;
}

.status-icon {
  width: 32rpx;
  height: 32rpx;
}

.status-icon--battery {
  width: 40rpx;
  height: 40rpx;
}

.content-scroll {
  flex: 1;
  height: 0;
  padding: 8rpx 48rpx 236rpx;
  box-sizing: border-box;
}

.fade-in-view {
  animation: fadeIn 0.35s ease-out both;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.page-header--home {
  margin-bottom: 8rpx;
}

.page-header--tight {
  margin-bottom: 48rpx;
}

.page-header--mistakes {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 60rpx;
  line-height: 1.1;
  color: #1b3827;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #6e8f7a;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.page-title--home {
  font-size: 52rpx;
  line-height: 1.04;
  letter-spacing: 0;
}

.page-subtitle--home {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.leaf-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #fdf7e3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
}

.leaf-badge--green {
  background: #d4e5d9;
}

.leaf-badge--home {
  width: 72rpx;
  height: 72rpx;
}

.leaf-badge__icon,
.page-header__side-icon {
  width: 40rpx;
  height: 40rpx;
}

.leaf-badge--home .leaf-badge__icon {
  width: 34rpx;
  height: 34rpx;
}

.hero-section {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  margin-bottom: 8rpx;
}

.hero-artwork {
  width: 620rpx;
  height: 450rpx;
  display: block;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 24rpx;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
}

.tool-card {
  position: relative;
  min-height: 196rpx;
  padding: 32rpx 20rpx;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.tool-card--highlight {
  border: 4rpx solid #d4e5d9;
}

.tool-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.tool-icon--yellow {
  background: #fdf7e3;
}

.tool-icon--green {
  background: #d4e5d9;
}

.tool-icon__img {
  width: 38rpx;
  height: 38rpx;
}

.tool-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ef4444;
  border: 4rpx solid #ffffff;
}

.tool-card__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b3827;
  line-height: 1.4;
}

.tool-card__subtitle {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #6e8f7a;
  line-height: 1.4;
}

.home-ai-card {
  width: 100%;
  border-radius: 36rpx;
  background: #ffffff;
  border: 4rpx solid transparent;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-ai-card__content {
  display: flex;
  align-items: center;
  column-gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.home-ai-card__badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #fdf7e3;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-ai-card__icon {
  width: 38rpx;
  height: 38rpx;
}

.home-ai-card__texts {
  min-width: 0;
}

.home-ai-card__title-row {
  display: flex;
  align-items: center;
  column-gap: 8rpx;
}

.home-ai-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1b3827;
  line-height: 1.3;
}

.home-ai-card__spark {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.home-ai-card__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6e8f7a;
  line-height: 1.4;
}

.home-ai-card__arrow-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #eef5f0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.home-ai-card__arrow {
  width: 30rpx;
  height: 30rpx;
}

.review-banner {
  position: relative;
  overflow: hidden;
  background: #2c5e43;
  border-radius: 36rpx;
  padding: 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.08);
  margin-top: 48rpx;
}

.review-banner__title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.review-banner__subtitle {
  display: block;
  margin-top: 8rpx;
  color: #a1c2b0;
  font-size: 22rpx;
  font-weight: 600;
}

.review-banner__action {
  position: absolute;
  top: 50%;
  right: 40rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
}

.review-banner__action-icon {
  width: 44rpx;
  height: 44rpx;
}

.review-banner__decor {
  position: absolute;
  right: -48rpx;
  bottom: -48rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.1;
}

.player-view,
.sub-view {
  padding-top: 24rpx;
}

.player-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 56rpx;
}

.player-topbar__center {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 8rpx;
}

.player-topbar__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1b3827;
}

.player-topbar__meta {
  font-size: 20rpx;
  color: #6e8f7a;
  font-weight: 700;
}

.circle-button {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-button--ghost {
  background: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

.circle-button__icon {
  width: 40rpx;
  height: 40rpx;
}

.player-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.player-progress__label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6e8f7a;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.player-progress__numbers {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-end;
  column-gap: 8rpx;
}

.player-progress__current {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: #1b3827;
}

.player-progress__slash,
.player-progress__total {
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #6e8f7a;
}

.player-card {
  position: relative;
  min-height: 440rpx;
  border-radius: 52rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.player-eye {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-eye__icon {
  width: 34rpx;
  height: 34rpx;
}

.player-card__label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6e8f7a;
}

.player-word {
  margin-top: 32rpx;
  font-size: 72rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b3827;
  letter-spacing: 8rpx;
  text-align: center;
  word-break: break-all;
  transition: filter 0.3s ease;
}

.player-word--blur {
  filter: blur(10rpx);
}

.player-card__hint {
  margin-top: 36rpx;
  font-size: 20rpx;
  color: #f87171;
  font-weight: 700;
}

.player-card__hint--hidden {
  opacity: 0;
}

.player-controls {
  background: #2c5e43;
  border-radius: 52rpx;
  padding: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 48rpx;
  margin-bottom: 24rpx;
}

.player-controls__button {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-controls__button--primary {
  width: 160rpx;
  height: 160rpx;
  background: #fdf7e3;
  box-shadow: 0 0 40rpx rgba(253, 247, 227, 0.3);
}

.player-controls__icon {
  width: 40rpx;
  height: 40rpx;
}

.player-controls__primary-icon {
  width: 72rpx;
  height: 72rpx;
}

.player-settings {
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 24rpx;
}

.autoplay-button {
  min-height: 76rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.autoplay-button__text {
  font-size: 24rpx;
  font-weight: 700;
  color: #1b3827;
}

.autoplay-button {
  background: #d4e5d9;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  column-gap: 12rpx;
}

.autoplay-button--active {
  background: #f87171;
}

.autoplay-button--active .autoplay-button__text {
  color: #ffffff;
}

.autoplay-button__icon {
  width: 32rpx;
  height: 32rpx;
}

.empty-card {
  min-height: 600rpx;
  border-radius: 52rpx;
  border: 4rpx dashed #b8d4c4;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.empty-card--compact {
  min-height: 420rpx;
}

.empty-card__circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #2c5e43;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 60rpx rgba(20, 83, 45, 0.2);
}

.empty-card__icon {
  width: 72rpx;
  height: 72rpx;
}

.empty-card__title {
  margin-top: 36rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1b3827;
}

.empty-card__desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  text-align: center;
  color: #6e8f7a;
  font-weight: 600;
  white-space: pre-line;
}

.section-heading {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1b3827;
}

.record-card {
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-card__content {
  display: flex;
  align-items: center;
  column-gap: 24rpx;
  flex: 1;
}

.record-card__score {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: #d4e5d9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.record-card__score-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b3827;
}

.record-card__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1b3827;
}

.record-card__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e8f7a;
}

.record-card__arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.correction-upload-card {
  position: relative;
  overflow: hidden;
  border-radius: 52rpx;
  margin-bottom: 24rpx;
}

.correction-upload-card__preview {
  width: 100%;
  height: 420rpx;
  display: block;
  border-radius: 52rpx;
}

.correction-upload-card__overlay {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(27, 56, 39, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(12rpx);
}

.correction-upload-card__overlay-text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.correction-source-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.correction-source-card__title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1b3827;
}

.correction-source-card__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6e8f7a;
}

.mistake-filter-row {
  width: 100%;
  margin-bottom: 24rpx;
  padding-top: 4rpx;
  padding-bottom: 4rpx;
}

.mistake-filter-row__inner {
  display: flex;
  align-items: center;
  column-gap: 12rpx;
  white-space: nowrap;
}

.mistake-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 136rpx;
  padding: 0 32rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #6e8f7a;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
}

.mistake-filter--active {
  background: #2c5e43;
  color: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(20, 83, 45, 0.2);
}

.mistake-list {
  display: flex;
  flex-direction: column;
  row-gap: 24rpx;
}

.mistake-card {
  position: relative;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 48rpx;
}

.mistake-card__badge {
  position: absolute;
  top: 0;
  right: 32rpx;
  min-height: 44rpx;
  padding: 0 24rpx;
  border-radius: 0 0 18rpx 18rpx;
  background: #fdf7e3;
  color: #b8860b;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mistake-card__label {
  display: block;
  font-size: 20rpx;
  color: #6e8f7a;
  font-weight: 700;
  text-transform: uppercase;
}

.mistake-card__word-row {
  display: flex;
  align-items: flex-end;
  column-gap: 10rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.mistake-card__word {
  font-size: 48rpx;
  color: #1b3827;
  font-weight: 700;
}

.mistake-card__phonetic {
  font-size: 22rpx;
  color: #6e8f7a;
  margin-bottom: 8rpx;
}

.mistake-card__answer {
  margin-top: 28rpx;
  border-radius: 24rpx;
  background: #eef5f0;
  padding: 24rpx;
  display: flex;
  align-items: center;
  column-gap: 20rpx;
}

.mistake-card__wrong {
  color: #f87171;
  font-size: 28rpx;
  font-weight: 700;
  text-decoration: line-through;
}

.mistake-card__tip {
  color: rgba(27, 56, 39, 0.8);
  font-size: 22rpx;
}

.correction-summary-card {
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 36rpx;
  margin-bottom: 28rpx;
}

.correction-summary-card__main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  column-gap: 24rpx;
}

.correction-summary-card__label {
  display: block;
  font-size: 22rpx;
  color: #6e8f7a;
  font-weight: 700;
}

.correction-summary-card__score-row {
  display: flex;
  align-items: flex-end;
  column-gap: 8rpx;
  margin-top: 14rpx;
}

.correction-summary-card__score {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: #1b3827;
}

.correction-summary-card__unit {
  font-size: 28rpx;
  font-weight: 700;
  color: #6e8f7a;
  margin-bottom: 10rpx;
}

.correction-summary-card__counts {
  display: flex;
  flex-direction: column;
  row-gap: 16rpx;
}

.correction-summary-pill {
  min-width: 120rpx;
  border-radius: 28rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.correction-summary-pill--good {
  background: #dff2e4;
}

.correction-summary-pill--warn {
  background: #fdf0e8;
}

.correction-summary-pill__value {
  font-size: 34rpx;
  font-weight: 800;
  color: #1b3827;
}

.correction-summary-pill__label {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #6e8f7a;
}

.correction-summary-card__meta {
  display: block;
  margin-top: 22rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6e8f7a;
}

.correction-detail-list {
  display: flex;
  flex-direction: column;
  row-gap: 20rpx;
}

.correction-detail-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 28rpx 32rpx;
}

.correction-detail-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  column-gap: 16rpx;
}

.correction-detail-card__index {
  font-size: 22rpx;
  font-weight: 700;
  color: #1b3827;
}

.correction-detail-card__status {
  min-width: 88rpx;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.correction-detail-card__status--good {
  background: #dff2e4;
  color: #2c5e43;
}

.correction-detail-card__status--warn {
  background: #fdf0e8;
  color: #d66d4b;
}

.correction-detail-card__line {
  margin-top: 18rpx;
}

.correction-detail-card__label {
  display: block;
  font-size: 18rpx;
  color: #6e8f7a;
  font-weight: 700;
  text-transform: uppercase;
}

.correction-detail-card__value {
