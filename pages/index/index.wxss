.desktop-shell {
  min-height: 100vh;
  display: flex;
  justify-content: center;
}

.screen {
  position: relative;
  width: 100%;
  max-width: 400px;
  min-height: 100vh;
  background: #eef5f0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: 12rpx;
  color: #1b3827;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.status-time {
  line-height: 1;
}

.status-icons {
  display: flex;
  align-items: center;
  column-gap: 12rpx;
  opacity: 0.8;
}

.status-icon {
  width: 32rpx;
  height: 32rpx;
}

.status-icon--battery {
  width: 40rpx;
  height: 40rpx;
}

.floating-rail {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 30;
}

.assistant-rail {
  background: #ffffff;
  border: 6rpx solid #1b3827;
  border-right: 0;
  border-radius: 32rpx 0 0 32rpx;
  box-shadow: -8rpx 8rpx 30rpx rgba(44, 94, 67, 0.15);
}

.assistant-rail {
  padding: 12rpx 12rpx 12rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 8rpx;
}

.assistant-rail__icon {
  width: 36rpx;
  height: 36rpx;
}

.assistant-rail__text {
  font-size: 20rpx;
  font-weight: 700;
  color: #2c5e43;
  writing-mode: vertical-rl;
  line-height: 1;
}

.content-scroll {
  flex: 1;
  height: 0;
  padding: 16rpx 48rpx 220rpx;
  box-sizing: border-box;
}

.fade-in-view {
  animation: fadeIn 0.35s ease-out both;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.page-header--tight {
  margin-bottom: 48rpx;
}

.page-header--mistakes {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 60rpx;
  line-height: 1.1;
  color: #1b3827;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #6e8f7a;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.leaf-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #fdf7e3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
}

.leaf-badge--green {
  background: #d4e5d9;
}

.leaf-badge__icon,
.page-header__side-icon {
  width: 40rpx;
  height: 40rpx;
}

.hero-section {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
  margin-bottom: 56rpx;
}

.hero-glow {
  position: absolute;
  top: 0;
  width: 416rpx;
  height: 416rpx;
  border-radius: 999rpx;
  background: #d4e5d9;
  opacity: 0.5;
  filter: blur(40rpx);
}

.hero-mark {
  position: absolute;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
}

.hero-mark--left {
  top: 12rpx;
  left: 36rpx;
}

.hero-mark--right {
  top: 72rpx;
  right: 36rpx;
  width: 34rpx;
  height: 34rpx;
}

.hero-illustration {
  position: relative;
  z-index: 2;
  width: 448rpx;
  height: 384rpx;
  animation: floatUpDown 4s ease-in-out infinite;
}

.hero-copy {
  position: relative;
  z-index: 2;
  margin-top: -40rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: #1b3827;
}

.hero-copy__cn,
.hero-copy__en {
  font-weight: 700;
  line-height: 1;
}

.hero-copy__cn--first {
  font-size: 52rpx;
  transform: rotate(-8deg) translateY(10rpx);
}

.hero-copy__cn--second {
  margin-left: 4rpx;
  font-size: 48rpx;
  transform: rotate(5deg) translateY(-6rpx);
}

.hero-copy__en {
  margin-left: 12rpx;
  font-size: 56rpx;
  font-family: "Times New Roman", serif;
}

.hero-copy__en--first {
  transform: rotate(-6deg) translateY(12rpx);
}

.hero-copy__en--second {
  margin-left: 6rpx;
  transform: rotate(8deg);
}

.hero-copy__en--third {
  margin-left: 10rpx;
  transform: rotate(-5deg) translateY(-6rpx);
}

.hero-copy__en--fourth {
  margin-left: 6rpx;
  transform: rotate(12deg) translateY(10rpx);
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 24rpx;
  margin-bottom: 56rpx;
}

.tool-card {
  position: relative;
  min-height: 188rpx;
  padding: 32rpx 20rpx;
  border-radius: 48rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.tool-card--highlight {
  border: 4rpx solid #d4e5d9;
}

.tool-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.tool-icon--yellow {
  background: #fdf7e3;
}

.tool-icon--green {
  background: #d4e5d9;
}

.tool-icon__img {
  width: 38rpx;
  height: 38rpx;
}

.tool-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 999rpx;
  background: #ef4444;
  border: 4rpx solid #ffffff;
}

.tool-card__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b3827;
  line-height: 1.4;
}

.tool-card__subtitle {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #6e8f7a;
  line-height: 1.4;
}

.review-banner {
  position: relative;
  overflow: hidden;
  background: #2c5e43;
  border-radius: 36rpx;
  padding: 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.08);
}

.review-banner__title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
}

.review-banner__subtitle {
  display: block;
  margin-top: 8rpx;
  color: #a1c2b0;
  font-size: 22rpx;
  font-weight: 600;
}

.review-banner__action {
  position: absolute;
  top: 50%;
  right: 40rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
}

.review-banner__action-icon {
  width: 44rpx;
  height: 44rpx;
}

.review-banner__decor {
  position: absolute;
  right: -48rpx;
  bottom: -48rpx;
  width: 220rpx;
  height: 220rpx;
  opacity: 0.1;
}

.player-view,
.sub-view {
  padding-top: 24rpx;
}

.player-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 56rpx;
}

.player-topbar__center {
  display: flex;
  flex-direction: column;
  align-items: center;
  row-gap: 8rpx;
}

.player-topbar__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1b3827;
}

.player-topbar__meta {
  font-size: 20rpx;
  color: #6e8f7a;
  font-weight: 700;
}

.circle-button {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-button--ghost {
  background: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

.circle-button__icon {
  width: 40rpx;
  height: 40rpx;
}

.player-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.player-progress__label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6e8f7a;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.player-progress__numbers {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-end;
  column-gap: 8rpx;
}

.player-progress__current {
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  color: #1b3827;
}

.player-progress__slash,
.player-progress__total {
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #6e8f7a;
}

.player-card {
  position: relative;
  min-height: 440rpx;
  border-radius: 52rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.player-eye {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-eye__icon {
  width: 34rpx;
  height: 34rpx;
}

.player-card__label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6e8f7a;
}

.player-word {
  margin-top: 32rpx;
  font-size: 72rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1b3827;
  letter-spacing: 8rpx;
  text-align: center;
  word-break: break-all;
  transition: filter 0.3s ease;
}

.player-word--blur {
  filter: blur(10rpx);
}

.player-card__hint {
  margin-top: 36rpx;
  font-size: 20rpx;
  color: #f87171;
  font-weight: 700;
}

.player-card__hint--hidden {
  opacity: 0;
}

.player-controls {
  background: #2c5e43;
  border-radius: 52rpx;
  padding: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 48rpx;
  margin-bottom: 24rpx;
}

.player-controls__button {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-controls__button--primary {
  width: 160rpx;
  height: 160rpx;
  background: #fdf7e3;
  box-shadow: 0 0 40rpx rgba(253, 247, 227, 0.3);
}

.player-controls__icon {
  width: 40rpx;
  height: 40rpx;
}

.player-controls__primary-icon {
  width: 72rpx;
  height: 72rpx;
}

.player-settings {
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 24rpx;
}

.interval-pill,
.autoplay-button {
  min-height: 76rpx;
  border-radius: 32rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.interval-pill {
  background: rgba(255, 255, 255, 0.6);
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  column-gap: 10rpx;
}

.interval-pill__icon {
  width: 30rpx;
  height: 30rpx;
}

.interval-pill__label,
.interval-pill__value,
.autoplay-button__text {
  font-size: 24rpx;
  font-weight: 700;
  color: #1b3827;
}

.autoplay-button {
  background: #d4e5d9;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  column-gap: 12rpx;
}

.autoplay-button--active {
  background: #f87171;
}

.autoplay-button--active .autoplay-button__text {
  color: #ffffff;
}

.autoplay-button__icon {
  width: 32rpx;
  height: 32rpx;
}

.empty-card {
  min-height: 600rpx;
  border-radius: 52rpx;
  border: 4rpx dashed #b8d4c4;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.empty-card__circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #2c5e43;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 60rpx rgba(20, 83, 45, 0.2);
}

.empty-card__icon {
  width: 72rpx;
  height: 72rpx;
}

.empty-card__title {
  margin-top: 36rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1b3827;
}

.empty-card__desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  text-align: center;
  color: #6e8f7a;
  font-weight: 600;
  white-space: pre-line;
}

.mistake-card {
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 48rpx;
}

.mistake-card__label {
  display: block;
  font-size: 20rpx;
  color: #6e8f7a;
  font-weight: 700;
  text-transform: uppercase;
}

.mistake-card__word {
  display: block;
  margin-top: 8rpx;
  font-size: 48rpx;
  color: #1b3827;
  font-weight: 700;
}

.mistake-card__answer {
  margin-top: 28rpx;
  border-radius: 24rpx;
  background: #eef5f0;
  padding: 24rpx;
  display: flex;
  align-items: center;
  column-gap: 20rpx;
}

.mistake-card__wrong {
  color: #f87171;
  font-size: 28rpx;
  font-weight: 700;
  text-decoration: line-through;
}

.mistake-card__tip {
  color: rgba(27, 56, 39, 0.8);
  font-size: 22rpx;
}

.review-target-card {
  border-radius: 40rpx;
  background: #fdf7e3;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-target-card__label {
  display: block;
  font-size: 20rpx;
  color: #a68a42;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.review-target-card__value {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-end;
  column-gap: 8rpx;
}

.review-target-card__count {
  font-size: 76rpx;
  line-height: 1;
  font-weight: 800;
  color: #1b3827;
}

.review-target-card__unit {
  font-size: 24rpx;
  font-weight: 700;
  color: #a68a42;
  margin-bottom: 10rpx;
}

.review-target-card__button {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: #2c5e43;
  box-shadow: 0 20rpx 50rpx rgba(20, 83, 45, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.review-target-card__button-icon {
  width: 48rpx;
  height: 48rpx;
}

.bottom-nav {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: 48rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.92);
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.08);
  z-index: 20;
}

.nav-item {
  flex: 1;
  min-height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 10rpx;
}

.nav-item--active {
  background: #d4e5d9;
}

.nav-item__icon {
  width: 36rpx;
  height: 36rpx;
}

.nav-item__text {
  font-size: 22rpx;
  font-weight: 700;
  color: #1b3827;
}

.overlay {
  position: absolute;
  inset: 0;
  background: rgba(27, 56, 39, 0.4);
  z-index: 40;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  border-radius: 52rpx 52rpx 0 0;
  background: #ffffff;
  padding: 48rpx;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.sheet-header--ai {
  margin-bottom: 36rpx;
}

.sheet-ai-title {
  display: flex;
  align-items: center;
  column-gap: 16rpx;
}

.sheet-ai-title__badge {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #fdf7e3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
}

.sheet-ai-title__icon,
.sheet-close__icon {
  width: 30rpx;
  height: 30rpx;
}

.sheet-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1b3827;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-note {
  display: block;
  margin-bottom: 32rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6e8f7a;
  font-weight: 600;
}

.config-block + .config-block {
  margin-top: 24rpx;
}

.config-block__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #1b3827;
}

.selector-row {
  display: flex;
  column-gap: 16rpx;
}

.selector-chip {
  min-width: 136rpx;
  height: 76rpx;
  border-radius: 28rpx;
  background: #eef5f0;
  border: 4rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1b3827;
  font-size: 26rpx;
  font-weight: 700;
}

.selector-chip--active {
  background: #2c5e43;
  border-color: #2c5e43;
  color: #ffffff;
}

.mode-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  column-gap: 16rpx;
}

.mode-card {
  min-height: 120rpx;
  border-radius: 28rpx;
  background: #eef5f0;
  border: 4rpx solid transparent;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  row-gap: 8rpx;
}

.mode-card--active {
  border-color: #2c5e43;
  background: #d4e5d9;
}

.mode-card--disabled {
  opacity: 0.45;
  background: #f3f4f6;
}

.mode-card__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b3827;
  text-align: center;
}

.mode-card__desc {
  font-size: 18rpx;
  color: #6e8f7a;
  text-align: center;
  line-height: 1.4;
}

.selection-summary {
  margin-top: 28rpx;
  border-radius: 28rpx;
  background: #fdf7e3;
  padding: 20rpx 24rpx;
}

.selection-summary__label {
  display: block;
  font-size: 20rpx;
  color: #a68a42;
  font-weight: 700;
}

.selection-summary__value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #1b3827;
  font-weight: 700;
}

.split-rule {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 28rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6e8f7a;
  font-weight: 600;
}

.sheet-textarea {
  width: 100%;
  height: 320rpx;
  border-radius: 32rpx;
  background: #eef5f0;
  padding: 32rpx;
  color: #1b3827;
  font-size: 30rpx;
  line-height: 1.6;
  font-weight: 700;
  margin-bottom: 40rpx;
}

.primary-button {
  width: 100%;
  height: 96rpx;
  border-radius: 32rpx;
  background: #2c5e43;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 12rpx;
  box-shadow: 0 20rpx 50rpx rgba(20, 83, 45, 0.2);
}

.primary-button__icon {
  width: 34rpx;
  height: 34rpx;
}

.primary-button__text {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.ai-card {
  border-radius: 32rpx;
  background: #eef5f0;
  border: 4rpx solid #d4e5d9;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-card + .ai-card {
  margin-top: 20rpx;
}

.ai-card__content {
  display: flex;
  align-items: center;
  column-gap: 20rpx;
}

.ai-card__badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(44, 94, 67, 0.04);
}

.ai-card__badge-icon,
.ai-card__arrow {
  width: 36rpx;
  height: 36rpx;
}

.ai-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1b3827;
}

.ai-card__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6e8f7a;
}

.analysis-summary {
  border-radius: 32rpx;
  background: #fdf7e3;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.analysis-summary__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b3827;
}

.analysis-summary__desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6e8f7a;
  font-weight: 600;
}

.analysis-item {
  border-radius: 28rpx;
  background: #eef5f0;
  padding: 24rpx;
}

.analysis-item + .analysis-item {
  margin-top: 18rpx;
}

.analysis-item__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1b3827;
}

.analysis-item__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #6e8f7a;
  font-weight: 600;
}

.analysis-action {
  margin-top: 28rpx;
  height: 92rpx;
  border-radius: 32rpx;
  background: #2c5e43;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(20, 83, 45, 0.2);
}

.analysis-action__text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.toast {
  position: absolute;
  top: 140rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 560rpx;
  border-radius: 999rpx;
  background: rgba(27, 56, 39, 0.92);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  column-gap: 10rpx;
  z-index: 60;
}

.toast__icon {
  width: 28rpx;
  height: 28rpx;
}

.toast__text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

@keyframes floatUpDown {
  0% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
  100% {
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
