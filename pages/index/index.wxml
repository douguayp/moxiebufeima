<view class="desktop-shell">
  <view class="screen">
    <view class="status-bar" style="padding-top: {{statusBarHeight}}px;">
      <text class="status-time">08:30</text>
      <view class="status-icons">
        <image class="status-icon" src="{{icons.barChartDark}}" mode="aspectFit" />
        <image class="status-icon" src="{{icons.wifiDark}}" mode="aspectFit" />
        <image class="status-icon status-icon--battery" src="{{icons.batteryDark}}" mode="aspectFit" />
      </view>
    </view>

    <scroll-view class="content-scroll {{activeView === 'photoSetup' ? 'content-scroll--photo-setup' : ''}}" scroll-y enhanced show-scrollbar="{{false}}">
      <block wx:if="{{activeView === 'dictate'}}">
        <view class="home-view fade-in-view">
          <view class="page-header page-header--home">
            <view>
              <text class="page-title page-title--home font-en">Relax, Mom</text>
              <text class="page-subtitle page-subtitle--home font-en">Take a breath</text>
            </view>
            <view class="leaf-badge leaf-badge--home">
              <image class="leaf-badge__icon" src="{{icons.leafDark}}" mode="aspectFit" />
            </view>
          </view>

          <view class="hero-section">
            <image class="hero-artwork" src="/assets/illustrations/home-hero.png" mode="aspectFit" />
          </view>

          <view class="tool-grid">
            <view class="tool-card tool-card--highlight" bindtap="handleToolTap" data-action="photo-dictation">
              <view class="tool-icon tool-icon--green">
                <image class="tool-icon__img" src="{{icons.cameraDark}}" mode="aspectFit" />
                <view class="tool-dot"></view>
              </view>
              <text class="tool-card__title">拍照默写</text>
              <text class="tool-card__subtitle">拍照 / 选图</text>
            </view>

            <view class="tool-card" bindtap="handleToolTap" data-action="camera">
              <view class="tool-icon tool-icon--yellow">
                <image class="tool-icon__img" src="{{icons.cameraDark}}" mode="aspectFit" />
              </view>
              <text class="tool-card__title">拍教材</text>
              <text class="tool-card__subtitle">AI帮你读</text>
            </view>

            <view class="tool-card" bindtap="handleToolTap" data-action="library">
              <view class="tool-icon tool-icon--yellow">
                <image class="tool-icon__img" src="{{icons.libraryDark}}" mode="aspectFit" />
              </view>
              <text class="tool-card__title">词句库</text>
              <text class="tool-card__subtitle">一键复用</text>
            </view>
          </view>

          <view class="home-ai-card" bindtap="openAiModal">
            <view class="home-ai-card__content">
              <view class="home-ai-card__badge">
                <image class="home-ai-card__icon" src="{{icons.botDark}}" mode="aspectFit" />
              </view>
              <view class="home-ai-card__texts">
                <view class="home-ai-card__title-row">
                  <text class="home-ai-card__title">AI 智能助手</text>
                  <image class="home-ai-card__spark" src="{{icons.sparklesPink}}" mode="aspectFit" />
                </view>
                <text class="home-ai-card__desc">一键生成易错词库，精准复习</text>
              </view>
            </view>
            <view class="home-ai-card__arrow-wrap">
              <image class="home-ai-card__arrow" src="{{icons.chevronRightMuted}}" mode="aspectFit" />
            </view>
          </view>

          <view class="review-banner" bindtap="goToReview">
            <view>
              <text class="review-banner__title">今日轻松复习</text>
              <text class="review-banner__subtitle">Review & Go play</text>
            </view>
            <view class="review-banner__action">
              <image class="review-banner__action-icon" src="{{icons.arrowRightWhite}}" mode="aspectFit" />
            </view>
            <image class="review-banner__decor" src="{{icons.apertureWhite}}" mode="aspectFit" />
          </view>
        </view>
      </block>

      <block wx:if="{{activeView === 'photoSetup'}}">
        <view class="sub-view sub-view--photo-setup fade-in-view">
          <view class="player-topbar">
            <view class="circle-button" bindtap="closePhotoRecognitionSetup">
              <image class="circle-button__icon" src="{{icons.chevronLeftDark}}" mode="aspectFit" />
            </view>
            <view class="player-topbar__center">
              <text class="player-topbar__title">确认默写内容</text>
              <text class="player-topbar__meta">确认识别文字后直接开始默写</text>
            </view>
            <view class="circle-button circle-button--ghost" bindtap="restartPhotoDictationFromSetup">
              <image class="circle-button__icon" src="{{icons.cameraDark}}" mode="aspectFit" />
            </view>
          </view>

          <view class="ocr-setup-card ocr-setup-card--result">
            <view class="ocr-setup-card__header">
              <view class="ocr-setup-card__title-row">
                <text class="ocr-setup-card__title">识别结果</text>
                <text class="ocr-setup-card__count">共 {{photoSetupDetectedCount}} 条</text>
              </view>
              <text class="ocr-setup-card__desc">默认可直接编辑。删除无关内容，改错字，每行一条更稳定。</text>
            </view>
            <textarea
              class="ocr-setup-textarea"
              value="{{photoSetupInput}}"
              maxlength="-1"
              placeholder="OCR 识别结果会显示在这里"
              bindinput="handlePhotoSetupInput"
            />
          </view>

          <view class="ocr-setup-card ocr-setup-card--params">
            <view class="ocr-setup-card__header">
              <view class="ocr-setup-card__title-row">
                <text class="ocr-setup-card__title">默写参数</text>
                <view class="ocr-header-switch">
                  <text class="ocr-header-switch__label">自动播放</text>
                  <switch checked="{{photoSetupAutoPlay}}" color="#2c5e43" bindchange="handlePhotoSetupAutoPlayChange" />
                </view>
              </view>
              <text class="ocr-setup-card__desc">先设好语速和间隔，再进入默写。</text>
            </view>

            <view class="ocr-setting-inline-grid">
              <picker mode="selector" range="{{speechRateLabels}}" value="{{selectedSpeechRateIndex}}" bindchange="handleSpeechRateChange">
                <view class="ocr-setting-select">
                  <view class="ocr-setting-select__main">
                    <image class="ocr-setting-select__icon" src="{{icons.volumeDark}}" mode="aspectFit" />
                    <view>
                      <text class="ocr-setting-select__label">语速</text>
                      <text class="ocr-setting-select__value">{{speechRateLabels[selectedSpeechRateIndex]}}</text>
                    </view>
                  </view>
                </view>
              </picker>

              <picker mode="selector" range="{{intervalOptions}}" value="{{selectedIntervalIndex}}" bindchange="handleIntervalChange">
                <view class="ocr-setting-select">
                  <view class="ocr-setting-select__main">
                    <image class="ocr-setting-select__icon" src="{{icons.timerDark}}" mode="aspectFit" />
                    <view>
                      <text class="ocr-setting-select__label">间隔</text>
                      <text class="ocr-setting-select__value">{{intervalOptions[selectedIntervalIndex]}}</text>
                    </view>
                  </view>
                </view>
              </picker>
            </view>

          </view>
        </view>
      </block>

      <block wx:if="{{activeView === 'player'}}">
        <view class="player-view fade-in-view">
          <view class="player-topbar">
            <view class="circle-button" bindtap="exitPlayer">
              <image class="circle-button__icon" src="{{icons.chevronLeftDark}}" mode="aspectFit" />
            </view>
            <view class="player-topbar__center">
              <text class="player-topbar__title">听写进行中</text>
            </view>
            <view class="circle-button circle-button--ghost" bindtap="handleSaveProgress">
              <image class="circle-button__icon" src="{{icons.saveDark}}" mode="aspectFit" />
            </view>
          </view>

          <view class="player-progress">
            <text class="player-progress__label">Progress</text>
            <view class="player-progress__numbers">
              <text class="player-progress__current">{{currentPlayerDisplay}}</text>
              <text class="player-progress__slash">/</text>
              <text class="player-progress__total">{{playerTotalCount}}</text>
            </view>
          </view>

          <view class="player-card">
            <view class="player-eye" bindtap="toggleReveal">
              <image class="player-eye__icon" src="{{revealed ? icons.eyeDark : icons.eyeOffDark}}" mode="aspectFit" />
            </view>
            <text class="player-card__label">{{playerCardLabel}}</text>
            <text class="player-word {{revealed ? '' : 'player-word--blur'}}">{{playerWord}}</text>
            <text class="player-card__hint {{revealed ? 'player-card__hint--hidden' : ''}}">点击右上方小眼睛偷看</text>
          </view>

          <view class="player-controls">
            <view class="player-controls__button" bindtap="prevWord">
              <image class="player-controls__icon" src="{{icons.skipBackWhite}}" mode="aspectFit" />
            </view>
            <view class="player-controls__button player-controls__button--primary" bindtap="playCurrentWord">
              <image class="player-controls__primary-icon" src="{{icons.volumeDark}}" mode="aspectFit" />
            </view>
            <view class="player-controls__button" bindtap="nextWord">
              <image class="player-controls__icon" src="{{icons.skipForwardWhite}}" mode="aspectFit" />
            </view>
          </view>

          <view class="player-settings">
            <view class="autoplay-button {{autoPlayEnabled ? 'autoplay-button--active' : ''}}" bindtap="toggleAutoPlay">
              <image class="autoplay-button__icon" src="{{icons.playSquareDark}}" mode="aspectFit" />
              <text class="autoplay-button__text">{{autoPlayEnabled ? '停止自动' : '自动播放'}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{activeView === 'grade'}}">
        <view class="sub-view fade-in-view">
          <view class="page-header page-header--tight">
            <view>
              <text class="page-title">AI Check</text>
              <text class="page-subtitle">Upload and review</text>
            </view>
            <view class="leaf-badge leaf-badge--green">
              <image class="leaf-badge__icon" src="{{icons.sparklesDark}}" mode="aspectFit" />
            </view>
          </view>

          <view class="correction-upload-card" bindtap="chooseCorrectionImage">
            <block wx:if="{{correctionImagePath}}">
              <image class="correction-upload-card__preview" src="{{correctionImagePath}}" mode="aspectFill" />
              <view class="correction-upload-card__overlay">
                <text class="correction-upload-card__overlay-text">重新选择照片</text>
              </view>
            </block>
            <block wx:else>
              <view class="empty-card empty-card--compact">
                <view class="empty-card__circle">
                  <image class="empty-card__icon" src="{{icons.scanLineWhite}}" mode="aspectFit" />
                </view>
                <text class="empty-card__title">上传默写照片</text>
                <text class="empty-card__desc">拍照或从相册选择{{'\n'}}进入 AI 批改流程</text>
              </view>
            </block>
          </view>

          <view class="correction-source-card">
            <text class="correction-source-card__title">{{correctionSourceTitle}}</text>
            <text class="correction-source-card__desc">{{correctionSourcePreview}}</text>
          </view>

          <view class="primary-button {{correctionBusy ? 'primary-button--disabled' : ''}}" bindtap="runCorrection">
            <image class="primary-button__icon" src="{{icons.playCircleWhite}}" mode="aspectFit" />
            <text class="primary-button__text">{{correctionBusy ? '批改中...' : '开始 AI 批改'}}</text>
          </view>

          <text class="section-heading">最近批改记录</text>
          <view class="record-card">
            <view class="record-card__content">
              <view class="record-card__score">
                <text class="record-card__score-text">{{recentCorrection.score}}</text>
              </view>
              <view>
                <text class="record-card__title">{{recentCorrection.title}}</text>
                <text class="record-card__meta">{{recentCorrection.meta}}</text>
              </view>
            </view>
            <image class="record-card__arrow" src="{{icons.chevronRightMuted}}" mode="aspectFit" />
          </view>
        </view>
      </block>

      <block wx:if="{{activeView === 'result'}}">
        <view class="sub-view fade-in-view">
          <view class="page-header page-header--tight">
            <view>
              <text class="page-title">Result</text>
              <text class="page-subtitle">AI correction summary</text>
            </view>
            <view class="leaf-badge leaf-badge--green">
              <image class="leaf-badge__icon" src="{{icons.sparklesDark}}" mode="aspectFit" />
            </view>
          </view>

          <view class="correction-summary-card">
            <view class="correction-summary-card__main">
              <view>
                <text class="correction-summary-card__label">本次正确率</text>
                <view class="correction-summary-card__score-row">
                  <text class="correction-summary-card__score">{{correctionResult.accuracy}}</text>
                  <text class="correction-summary-card__unit">%</text>
                </view>
              </view>
              <view class="correction-summary-card__counts">
                <view class="correction-summary-pill correction-summary-pill--good">
                  <text class="correction-summary-pill__value">{{correctionResult.correctCount}}</text>
                  <text class="correction-summary-pill__label">正确</text>
                </view>
                <view class="correction-summary-pill correction-summary-pill--warn">
                  <text class="correction-summary-pill__value">{{correctionResult.wrongCount}}</text>
                  <text class="correction-summary-pill__label">错误</text>
                </view>
              </view>
            </view>
            <text class="correction-summary-card__meta">已按“标准答案 vs OCR 识别结果”生成逐题明细</text>
          </view>

          <view class="correction-detail-list">
            <view wx:for="{{correctionResult.details}}" wx:key="id" class="correction-detail-card">
              <view class="correction-detail-card__top">
                <text class="correction-detail-card__index">第 {{item.index}} 题</text>
                <text class="correction-detail-card__status {{item.correct ? 'correction-detail-card__status--good' : 'correction-detail-card__status--warn'}}">
                  {{item.correct ? '正确' : '错误'}}
                </text>
              </view>
              <view class="correction-detail-card__line">
                <text class="correction-detail-card__label">标准答案</text>
                <text class="correction-detail-card__value">{{item.expectedText}}</text>
              </view>
              <view class="correction-detail-card__line">
                <text class="correction-detail-card__label">识别结果</text>
                <text class="correction-detail-card__value {{item.correct ? '' : 'correction-detail-card__value--wrong'}}">{{item.recognizedText}}</text>
              </view>
              <text class="correction-detail-card__tip">{{item.tip}}</text>
            </view>
          </view>

          <view wx:if="{{correctionResult.wrongCount > 0}}" class="primary-button {{correctionWrongItemsAdded ? 'primary-button--disabled' : ''}}" bindtap="addWrongItemsToBook">
            <image class="primary-button__icon" src="{{icons.arrowRightWhite}}" mode="aspectFit" />
            <text class="primary-button__text">{{correctionWrongItemsAdded ? '已加入错题本' : '将错误项加入错题本'}}</text>
          </view>

          <view class="secondary-button" bindtap="openMistakeBook">
            <text class="secondary-button__text">查看错题本</text>
          </view>

          <view class="ghost-button" bindtap="restartCorrection">
            <text class="ghost-button__text">继续拍照批改</text>
          </view>
        </view>
      </block>

      <block wx:if="{{activeView === 'mistakes'}}">
        <view class="sub-view fade-in-view">
          <view class="page-header page-header--mistakes">
            <view>
              <text class="page-title">Mistakes</text>
              <text class="page-subtitle">Growth points</text>
            </view>
            <image class="page-header__side-icon" src="{{icons.targetDark}}" mode="aspectFit" />
          </view>

          <scroll-view class="mistake-filter-row" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="mistake-filter-row__inner">
              <view
                wx:for="{{mistakeFilters}}"
                wx:key="key"
                class="mistake-filter {{item.active ? 'mistake-filter--active' : ''}}"
                bindtap="setMistakeFilter"
                data-filter="{{item.key}}"
              >
                {{item.label}}
              </view>
            </view>
          </scroll-view>

          <view class="mistake-list">
            <view wx:for="{{displayMistakes}}" wx:key="id" class="mistake-card">
              <view wx:if="{{item.badge}}" class="mistake-card__badge">{{item.badge}}</view>
              <text class="mistake-card__label">Standard</text>
              <view class="mistake-card__word-row">
                <text class="mistake-card__word">{{item.word}}</text>
                <text wx:if="{{item.phonetic}}" class="mistake-card__phonetic">({{item.phonetic}})</text>
              </view>
              <view class="mistake-card__answer">
                <text class="mistake-card__wrong">{{item.wrong}}</text>
                <text class="mistake-card__tip">{{item.tip}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{activeView === 'review'}}">
        <view class="sub-view fade-in-view">
          <view class="page-header page-header--tight">
            <view>
              <text class="page-title">Review</text>
              <text class="page-subtitle">Smart memory</text>
            </view>
            <image class="page-header__side-icon" src="{{icons.calendarHeartDark}}" mode="aspectFit" />
          </view>

          <view class="review-target-card">
            <view>
              <text class="review-target-card__label">Today's Target</text>
              <view class="review-target-card__value">
                <text class="review-target-card__count">{{reviewTarget}}</text>
                <text class="review-target-card__unit">词</text>
              </view>
            </view>
            <view class="review-target-card__button" bindtap="handleReviewPlay">
              <image class="review-target-card__button-icon" src="{{icons.playWhite}}" mode="aspectFit" />
            </view>
          </view>

          <view class="review-timeline">
            <view wx:for="{{reviewTimeline}}" wx:key="id" class="review-timeline__item {{item.dimmed ? 'review-timeline__item--dimmed' : ''}}">
              <view class="review-timeline__marker">
                <view class="review-timeline__dot {{item.active ? 'review-timeline__dot--active' : ''}}"></view>
              </view>
              <view class="review-timeline__content">
                <text class="review-timeline__label {{item.active ? 'review-timeline__label--active' : ''}}">{{item.label}}</text>
                <view class="review-task-card">
                  <view class="review-task-card__content">
                    <text class="review-task-card__title">{{item.title}}</text>
                    <text class="review-task-card__meta">{{item.subtitle}}</text>
                  </view>
                  <text wx:if="{{item.status}}" class="review-task-card__status">{{item.status}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>

    <view wx:if="{{activeView === 'photoCapture'}}" class="photo-capture-overlay">
      <camera class="photo-capture-camera" device-position="back" flash="auto" binderror="handlePhotoCameraError"></camera>
      <cover-view class="photo-capture-mask">
        <cover-view class="photo-capture-topbar">
          <cover-view class="photo-capture-close" bindtap="closePhotoCaptureView">关闭</cover-view>
          <cover-view class="photo-capture-title">拍照默写</cover-view>
          <cover-view class="photo-capture-placeholder"></cover-view>
        </cover-view>

        <cover-view class="photo-capture-bottom">
          <cover-view class="photo-capture-tip">拍摄要默写的区域</cover-view>
          <cover-view class="photo-capture-shutter" bindtap="takePhotoForDictation">
            <cover-view class="photo-capture-shutter__inner"></cover-view>
          </cover-view>
        </cover-view>
      </cover-view>
    </view>

    <view wx:if="{{activeView !== 'player' && activeView !== 'result' && activeView !== 'photoCapture' && activeView !== 'photoSetup'}}" class="bottom-nav">
      <view class="nav-item {{activeView === 'dictate' ? 'nav-item--active' : 'nav-item--inactive'}}" bindtap="switchTab" data-view="dictate">
        <image class="nav-item__icon" src="{{activeView === 'dictate' ? icons.homeDark : icons.homeMuted}}" mode="aspectFit" />
        <text class="nav-item__text {{activeView === 'dictate' ? 'nav-item__text--active' : 'nav-item__text--inactive'}}">主页</text>
      </view>
      <view class="nav-item {{activeView === 'grade' ? 'nav-item--active' : 'nav-item--inactive'}}" bindtap="switchTab" data-view="grade">
        <image class="nav-item__icon" src="{{activeView === 'grade' ? icons.checkSquareDark : icons.checkSquareMuted}}" mode="aspectFit" />
        <text class="nav-item__text {{activeView === 'grade' ? 'nav-item__text--active' : 'nav-item__text--inactive'}}">批改</text>
      </view>
      <view class="nav-item {{activeView === 'mistakes' ? 'nav-item--active' : 'nav-item--inactive'}}" bindtap="switchTab" data-view="mistakes">
        <image class="nav-item__icon" src="{{activeView === 'mistakes' ? icons.bookXDark : icons.bookXMuted}}" mode="aspectFit" />
        <text class="nav-item__text {{activeView === 'mistakes' ? 'nav-item__text--active' : 'nav-item__text--inactive'}}">错题</text>
      </view>
      <view class="nav-item {{activeView === 'review' ? 'nav-item--active' : 'nav-item--inactive'}}" bindtap="switchTab" data-view="review">
        <image class="nav-item__icon" src="{{activeView === 'review' ? icons.calendarDark : icons.calendarMuted}}" mode="aspectFit" />
        <text class="nav-item__text {{activeView === 'review' ? 'nav-item__text--active' : 'nav-item__text--inactive'}}">复习</text>
      </view>
    </view>

    <view wx:if="{{activeView === 'photoSetup'}}" class="page-fixed-footer">
      <view class="page-fixed-footer__inner">
        <view class="primary-button primary-button--footer" bindtap="startPhotoDictationFromSetup">
          <image class="primary-button__icon" src="{{icons.playCircleWhite}}" mode="aspectFit" />
          <text class="primary-button__text">开始默写</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showPasteModal}}" class="overlay" bindtap="closePasteModal">
      <view class="sheet" catchtap="noop">
        <view class="sheet-header">
          <text class="sheet-title">准备听写内容</text>
          <view class="sheet-close" bindtap="closePasteModal">
            <image class="sheet-close__icon" src="{{icons.xMuted}}" mode="aspectFit" />
          </view>
        </view>
        <text class="sheet-note">直接粘贴内容即可。系统会自动拆分条目，并识别中文或英文进行对应播报。</text>

        <picker mode="selector" range="{{intervalOptions}}" value="{{selectedIntervalIndex}}" bindchange="handleIntervalChange">
          <view class="interval-setting-card">
            <view class="interval-setting-card__content">
              <image class="interval-setting-card__icon" src="{{icons.timerDark}}" mode="aspectFit" />
              <view>
                <text class="interval-setting-card__title">朗读间隔</text>
                <text class="interval-setting-card__desc">开始听写后自动播放将使用这个间隔</text>
              </view>
            </view>
            <text class="interval-setting-card__value">{{intervalOptions[selectedIntervalIndex]}}</text>
          </view>
        </picker>

        <view class="sheet-textarea-wrap">
          <textarea
            class="sheet-textarea"
            value="{{pasteInput}}"
            placeholder="{{pastePlaceholder}}"
            maxlength="-1"
            bindinput="handlePasteInput"
          />
          <text class="sheet-textarea-tip">内容较多时可在输入框内上下滚动查看</text>
        </view>
        <view class="primary-button" bindtap="startDictation">
          <image class="primary-button__icon" src="{{icons.playCircleWhite}}" mode="aspectFit" />
          <text class="primary-button__text">开始智能听写</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showPhotoConfirmSheet}}" class="overlay">
      <view class="sheet sheet--photo-confirm" catchtap="noop">
        <view class="sheet-header">
          <text class="sheet-title">拍照默写</text>
          <view class="sheet-close" bindtap="closePhotoConfirmSheet">
            <image class="sheet-close__icon" src="{{icons.xMuted}}" mode="aspectFit" />
          </view>
        </view>
        <text class="sheet-note">确认当前照片后继续。需要调整范围时，点击裁剪进入自由裁剪层。</text>

        <view class="photo-confirm-preview">
          <image class="photo-confirm-preview__image" src="{{photoConfirmImagePath}}" mode="aspectFit" />
        </view>

        <view class="photo-confirm-actions">
          <view class="photo-confirm-action photo-confirm-action--ghost" bindtap="retakePhotoConfirm">
            <text class="photo-confirm-action__text">重拍</text>
          </view>
          <view class="photo-confirm-action photo-confirm-action--soft" bindtap="applyPhotoConfirmCrop">
            <text class="photo-confirm-action__text">裁剪</text>
          </view>
          <view class="photo-confirm-action photo-confirm-action--primary" bindtap="finishPhotoDictation">
            <text class="photo-confirm-action__text photo-confirm-action__text--white">完成</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{showPhotoCropSheet}}" class="photo-crop-fullscreen">
      <view class="photo-crop-fullscreen__header">
        <view class="photo-crop-fullscreen__action" bindtap="closePhotoCropSheet">返回</view>
        <text class="photo-crop-fullscreen__title">自由裁剪</text>
        <view class="photo-crop-fullscreen__action photo-crop-fullscreen__action--ghost" bindtap="retakePhotoConfirm">重拍</view>
      </view>
      <view class="photo-crop-fullscreen__body">
        <view
          class="photo-crop-stage"
          style="width: {{photoCropStageWidthPx}}px; height: {{photoCropStageHeightPx}}px;"
          catchtouchmove="movePhotoCropGesture"
          catchtouchend="endPhotoCropGesture"
          catchtouchcancel="endPhotoCropGesture"
        >
          <image
            class="photo-crop-stage__image"
            src="{{photoCropImagePath}}"
            mode="aspectFit"
            style="width: {{photoCropRenderWidthPx}}px; height: {{photoCropRenderHeightPx}}px; left: {{photoCropRenderOffsetXPx}}px; top: {{photoCropRenderOffsetYPx}}px;"
          />
          <view class="photo-crop-mask photo-crop-mask--top" style="left: {{photoCropRenderOffsetXPx}}px; top: {{photoCropRenderOffsetYPx}}px; width: {{photoCropRenderWidthPx}}px; height: {{photoCropRectTopPx - photoCropRenderOffsetYPx}}px;"></view>
          <view class="photo-crop-mask photo-crop-mask--left" style="left: {{photoCropRenderOffsetXPx}}px; top: {{photoCropRectTopPx}}px; width: {{photoCropRectLeftPx - photoCropRenderOffsetXPx}}px; height: {{photoCropRectHeightPx}}px;"></view>
          <view class="photo-crop-mask photo-crop-mask--right" style="left: {{photoCropRectLeftPx + photoCropRectWidthPx}}px; top: {{photoCropRectTopPx}}px; width: {{photoCropRenderOffsetXPx + photoCropRenderWidthPx - (photoCropRectLeftPx + photoCropRectWidthPx)}}px; height: {{photoCropRectHeightPx}}px;"></view>
          <view class="photo-crop-mask photo-crop-mask--bottom" style="left: {{photoCropRenderOffsetXPx}}px; top: {{photoCropRectTopPx + photoCropRectHeightPx}}px; width: {{photoCropRenderWidthPx}}px; height: {{photoCropRenderOffsetYPx + photoCropRenderHeightPx - (photoCropRectTopPx + photoCropRectHeightPx)}}px;"></view>

          <view
            class="photo-crop-rect"
            style="left: {{photoCropRectLeftPx}}px; top: {{photoCropRectTopPx}}px; width: {{photoCropRectWidthPx}}px; height: {{photoCropRectHeightPx}}px;"
            bindtouchstart="startPhotoCropGesture"
            data-handle="move"
          >
            <view class="photo-crop-grid"></view>
            <view class="photo-crop-handle photo-crop-handle--tm" catchtouchstart="startPhotoCropGesture" data-handle="tm">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--tl" catchtouchstart="startPhotoCropGesture" data-handle="tl">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--tr" catchtouchstart="startPhotoCropGesture" data-handle="tr">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--rm" catchtouchstart="startPhotoCropGesture" data-handle="rm">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--bl" catchtouchstart="startPhotoCropGesture" data-handle="bl">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--bm" catchtouchstart="startPhotoCropGesture" data-handle="bm">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--br" catchtouchstart="startPhotoCropGesture" data-handle="br">
              <view class="photo-crop-handle__dot"></view>
            </view>
            <view class="photo-crop-handle photo-crop-handle--lm" catchtouchstart="startPhotoCropGesture" data-handle="lm">
              <view class="photo-crop-handle__dot"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="photo-crop-fullscreen__footer">
        <view class="photo-confirm-action photo-confirm-action--soft" bindtap="closePhotoCropSheet">
          <text class="photo-confirm-action__text">取消</text>
        </view>
        <view class="photo-confirm-action photo-confirm-action--primary" bindtap="confirmPhotoCrop">
          <text class="photo-confirm-action__text photo-confirm-action__text--white">完成裁剪</text>
        </view>
      </view>

      <canvas canvas-id="photoCropCanvas" class="photo-crop-canvas" style="width: 1200px; height: 1600px;" />
    </view>

    <view wx:if="{{showAiModal}}" class="overlay" bindtap="closeAiModal">
      <view class="sheet" catchtap="noop">
        <view class="sheet-header sheet-header--ai">
          <view class="sheet-ai-title">
            <view class="sheet-ai-title__badge">
              <image class="sheet-ai-title__icon" src="{{icons.botDark}}" mode="aspectFit" />
            </view>
            <text class="sheet-title">AI 智能助手</text>
          </view>
          <view class="sheet-close" bindtap="closeAiModal">
            <image class="sheet-close__icon" src="{{icons.xMuted}}" mode="aspectFit" />
          </view>
        </view>
        <text class="sheet-note">我可以帮您自动分析薄弱点并生成针对性的复习任务。</text>

        <view class="ai-card" bindtap="handleAiAction" data-action="generate">
          <view class="ai-card__content">
            <view class="ai-card__badge">
              <image class="ai-card__badge-icon" src="{{icons.sparklesGreen}}" mode="aspectFit" />
            </view>
            <view class="ai-card__texts">
              <text class="ai-card__title">一键生成易错词库</text>
              <text class="ai-card__desc">根据历史错题自动组卷出题</text>
            </view>
          </view>
          <image class="ai-card__arrow" src="{{icons.chevronRightMuted}}" mode="aspectFit" />
        </view>

        <view class="ai-card" bindtap="handleAiAction" data-action="analysis">
          <view class="ai-card__content">
            <view class="ai-card__badge">
              <image class="ai-card__badge-icon" src="{{icons.barChartHorizontalGreen}}" mode="aspectFit" />
            </view>
            <view class="ai-card__texts">
              <text class="ai-card__title">薄弱知识点分析</text>
              <text class="ai-card__desc">精准定位孩子复习重点</text>
            </view>
          </view>
          <image class="ai-card__arrow" src="{{icons.chevronRightMuted}}" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view wx:if="{{showAnalysisSheet}}" class="overlay" bindtap="closeAnalysisSheet">
      <view class="sheet" catchtap="noop">
        <view class="sheet-header">
          <text class="sheet-title">薄弱知识点分析</text>
          <view class="sheet-close" bindtap="closeAnalysisSheet">
            <image class="sheet-close__icon" src="{{icons.xMuted}}" mode="aspectFit" />
          </view>
        </view>

        <view class="analysis-summary">
          <text class="analysis-summary__title">{{analysisTitle}}</text>
          <text class="analysis-summary__desc">{{analysisSubtitle}}</text>
        </view>

        <view wx:for="{{analysisItems}}" wx:key="title" class="analysis-item">
          <text class="analysis-item__title">{{item.title}}</text>
          <text class="analysis-item__desc">{{item.desc}}</text>
        </view>

        <view class="analysis-action" bindtap="closeAnalysisSheet">
          <text class="analysis-action__text">{{analysisActionText}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{showToast}}" class="toast">
      <image class="toast__icon" src="{{icons.bellYellow}}" mode="aspectFit" />
      <text class="toast__text">{{toastMessage}}</text>
    </view>
  </view>
</view>
