page {
  background: #e8f0ea;
  color: #1b3827;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
}

view,
text,
textarea,
picker,
input,
button {
  box-sizing: border-box;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
}

image,
scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}

.font-zh {
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
}

.font-en {
  font-family: "Caveat Brush", "Times New Roman", serif;
}

button::after {
  border: 0;
}
